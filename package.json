{
  "name": "kor-travel-common",
  "private": true,
  "license": "GPL-3.0-or-later",
  "packageManager": "npm@12.0.1",
  "engines": {
    "node": "22.23.1",
    "npm": "12.0.1"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace packages/tokens && npm run build --workspace packages/ui",
    "check": "npm run check --workspace packages/tokens && npm run check --workspace packages/ui",
    "test": "npm run test:toolchain && npm test --workspace packages/tokens && npm test --workspace packages/ui",
    "lint": "eslint packages/ui/src packages/ui/examples",
    "doctor": "npm run doctor --workspace packages/ui",
    "check:policy": "node tools/sync_frontend_policy.mjs --check",
    "check:toolchain": "node tools/check_node_toolchain.mjs --runtime",
    "test:toolchain": "node --test tests/check_node_toolchain.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@mdx-js/mdx": "3.1.1",
    "@playwright/test": "1.65.0",
    "@radix-ui/react-focus-scope": "file:vendor/radix-ui-react-focus-scope-1.3.1+kortravel.fix.2.tgz",
    "eslint": "10.14.0",
    "ini": "7.0.0",
    "lightningcss": "file:vendor/lightningcss-1.33.0+nativecss.fix.4.tgz",
    "react-doctor": "0.9.22",
    "typescript-eslint": "8.72.2"
  },
  "overrides": {
    "lightningcss": "$lightningcss",
    "@radix-ui/react-focus-scope": "$@radix-ui/react-focus-scope"
  }
}
