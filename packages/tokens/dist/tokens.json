    "kor-travel-common": {
      "profiles": {
        "admin": {
          "description": "공용 admin 밀도 프로필",
          "radius": {
            "control": "{radius.control}",
            "panel": "{radius.panel}"
          },
          "controlHeight": {
            "default": "{control.h}",
            "small": "{control.h-sm}"
          },
          "body": "sm",
          "typeScale": [
            "2xs",
            "xs",
            "sm",
            "md",
            "lg",
            "xl",
            "2xl"
          ]
        },
        "consumer": {
          "description": "의미 이름만 common이 제공하며 값과 밀도는 소비자가 소유한다.",
          "ownedBy": "consumer",
          "semanticGroups": [
            "surface",
            "text",
            "brand",
            "status",
            "font"
          ]
        }
      }
    }
  },
