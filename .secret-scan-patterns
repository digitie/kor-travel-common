# 정규식과 정확한 파일 단위 예외만 둔다. 실제 값은 금지한다.
version = 1

[[patterns]]
id = "SECRET-ASSIGNMENT"
regex = '''(?i)(?<![\w])(?:[a-z0-9]+_)*(?:api[_-]?key|client[_-]?secret|secret|password|passwd|access[_-]?token|refresh[_-]?token|token)\b["']?\s*[:=]\s*["']?[A-Za-z0-9+/_.=-]{8,}'''

[[patterns]]
id = "SECRET-QUOTED"
regex = '''(?i)(?<![\w])(?:[a-z0-9]+_)*(?:api[_-]?key|client[_-]?secret|secret|password|passwd|access[_-]?token|refresh[_-]?token|token)\b["']?\s*[:=]\s*["'][^"'\r\n<${}]+["']'''

[[patterns]]
id = "PRIVATE-KEY"
regex = '''-----BEGIN (?:[A-Z0-9]+ )?PRIVATE KEY-----'''

[[patterns]]
id = "AWS-ACCESS-KEY"
regex = '''\b(?:AKIA|ASIA)[0-9A-Z]{16}\b'''

[[patterns]]
id = "GITHUB-TOKEN"
regex = '''\b(?:gh[pousr]_[A-Za-z0-9]{30,}|github_pat_[A-Za-z0-9_]{50,})\b'''

[[patterns]]
id = "PASSWORD-HASH"
regex = '''\bpbkdf2_sha256\$[0-9]+\$[^\s$]+\$[A-Za-z0-9+/=]+'''

[[patterns]]
id = "URL-CREDENTIAL"
regex = '''(?i)\b[a-z][a-z0-9+.-]*://[^\s/:@<>]+:[^\s/@<>]+@'''
